# ORACLE Environment Configuration
# Copy this file to .env. Never commit .env into source control.
ORACLE_SECRET=change-me-to-a-secure-random-secret-key-32-chars
PORT=8000
ORACLE_DB=oracle.db

# Live Market Data Providers:
TWELVEDATA_KEY=         # TwelveData global real-time equities, FX & commodities: twelvedata.com
FINNHUB_KEY=            # Finnhub stock quotes, metrics, fundamentals & company news: finnhub.io
ALPHAVANTAGE_KEY=       # Alpha Vantage real-time commodities & forex: alphavantage.co
OILPRICE_KEY=           # OilPriceAPI live crude oil & natural gas benchmarks: oilpriceapi.com
BINANCE_API_KEY=        # Binance spot crypto price & 24hr klines ticker data: binance.com

# Broker & Paper Trading Integrations:
ALPACA_KEY_ID=          # Alpaca paper trading API key
ALPACA_SECRET_KEY=      # Alpaca paper trading API secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Optional Production Integrations:
DATABASE_URL=           # e.g. postgresql://user:pass@localhost:5432/oracle_db
RAZORPAY_KEY_ID=        # Indian payment gateway integration
RAZORPAY_KEY_SECRET=    # Webhook signature verification
STRIPE_SECRET_KEY=      # Global subscription payments
CRICAPI_KEY=            # Live international cricket matches & stats: cricketdata.org
